{
  "name": "dsh-ralph",
  "version": "1.1.0",
  "description": "Ralph 自主 AI 循环的 DeepSeek Harness 插件：反复启动全新子 agent，逐个实现 prd.json 中的用户故事，直到全部完成",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "ralph",
    "agent-loop",
    "autonomous",
    "prd",
    "ai-agent"
  ],
  "author": "aaxiaomi <296629801@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsadasdasdsad035-spec/dsh-ralph.git"
  },
  "bugs": {
    "url": "https://github.com/dsadasdasdsad035-spec/dsh-ralph/issues"
  },
  "homepage": "https://github.com/dsadasdasdsad035-spec/dsh-ralph#readme",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "prompts",
    "skills",
    "cordis.patch.yml",
    "prd.json.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "verify": "node scripts/verify-load.mjs",
    "prepublishOnly": "npm test && npm run verify"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
