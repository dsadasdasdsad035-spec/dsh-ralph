{
  "name": "dsh-ralph",
  "version": "1.0.0",
  "description": "Ralph 自主 AI 循环的 DeepSeek Harness 插件：反复启动全新子 agent，逐个实现 prd.json 中的用户故事，直到全部完成",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "ralph",
    "agent-loop",
    "autonomous"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "prompts",
    "skills",
    "cordis.patch.yml",
    "prd.json.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT"
}
